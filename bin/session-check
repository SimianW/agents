#!/bin/sh
# SessionStart hook for Claude Code and Codex. Prints a notice only when ~/.agents is out of step with GitHub.
cd "$HOME/.agents" 2>/dev/null || exit 0
dirty=$(git status --porcelain 2>/dev/null | wc -l)
set -- $(git rev-list --left-right --count 'HEAD...@{u}' 2>/dev/null || echo 0 0)
[ "$dirty" -eq 0 ] && [ "$1" -eq 0 ] && [ "$2" -eq 0 ] && exit 0
echo "~/.agents is out of step with GitHub: $dirty uncommitted file(s), $1 unpushed commit(s), $2 commit(s) the sync timer could not pull. Tell the user at the start of your first reply; ~/.agents/README.md explains how to resolve it."
